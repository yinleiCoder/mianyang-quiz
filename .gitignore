.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 本地配置（--dart-define-from-file 注入），含后端地址与密钥，绝不入库。
# 模板见 config/dev.example.json
config/dev.json
config/*.local.json

# 混淆构建的调试符号（--split-debug-info 的落点）：体积大、且能反解混淆，不入库。
# 崩溃排查要用它，请另行归档（发布步骤见 AGENTS.md 第七节）。
symbols/

# Android 正式签名：私钥与其口令**绝不入库**（CI 从仓库 secret 解码到本地后即用即弃）
android/key.properties
*.keystore
*.jks

# CI 编译安装器时下载的中文语言文件（Inno 官方发行版不含中文）
windows/ChineseSimplified.isl
